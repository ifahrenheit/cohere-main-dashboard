# ==========================================
# COHERE DASHBOARD - .gitignore (Optimized)
# ==========================================

# --------------------
# SENSITIVE FILES
# --------------------
config.php
db_connection.php
database.php
connection.php
ldap_config.php
.env
*.env
credentials.json
api/credentials.json

# Keep example config files
!config.example.php
!db_connection.example.php

# --------------------
# SUB-PROJECTS (Separate repos)
# --------------------
/cohere_dashboard_frontend/
/coaching/.git/
/coaching/

# --------------------
# NODE_MODULES & DEPENDENCIES
# --------------------
node_modules/
/cohere_dashboard_frontend/node_modules/
/api/node_modules/
vendor/
/api/vendor/
composer.lock
package-lock.json

# --------------------
# USER UPLOADS & IMAGES
# --------------------
/uploads/*
!/uploads/.gitkeep
/coaching/uploads/*
!/coaching/uploads/.gitkeep
/coaching/uploads/profile_pictures/*  # Optional: track profile pics if needed
/incident_report/uploads/*            # Ignore all IR images

# Ignore image files globally if never tracked
*.png
*.jpg
*.jpeg
*.gif

# --------------------
# LOGS & DEBUG FILES
# --------------------
*.log
/logs/*
error_log
debug.log
phpmailer_debug.log
api/debug.log

# --------------------
# BACKUP & OLD FILES
# --------------------
*-backup.php
*-bak.php
*-old.php
*-OLD.php
*.backup
*.bak
*.old
dashboard-backup.php
dashboard-bak.php

# --------------------
# TEST FILES
# --------------------
test.php
test_*.php
*_test.php
testing*.php
info.php

# --------------------
# TEMPORARY & CACHE FILES
# --------------------
tempfile.csv
*.tmp
/tmp/*
/cache/*
/sessions/*

# --------------------
# DATABASE DUMPS
# --------------------
*.sql
*.sql.gz
*.dump

# --------------------
# COMPRESSED FILES
# --------------------
*.zip
*.tar
*.tar.gz
*.rar

# --------------------
# OS FILES
# --------------------
.DS_Store
Thumbs.db
desktop.ini

# --------------------
# IDE / EDITOR FILES
# --------------------
.vscode/
.idea/
*.swp
*.swo

# --------------------
# CREDENTIALS / SECRETS
# --------------------
google-credentials.json
/secrets/
/var/www/secrets/